# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/apna-kashichak

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Google Drive ----------
# Create OAuth2 credentials in Google Cloud Console (APIs & Services > Credentials)
# Enable the "Google Drive API" for your project.
# Use the OAuth2 Playground (https://developers.google.com/oauthplayground) with your own
# client id/secret to generate a refresh token that has drive.file scope.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ---------- Uploads ----------
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
